  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.1.1"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
