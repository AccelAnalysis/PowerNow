{
  "name": "power-now-direct-sales-site",
  "version": "0.2.0",
  "private": true,
  "description": "Direct sales storefront for the Power NOW book series.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
