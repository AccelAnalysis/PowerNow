# Public site URL.
NEXT_PUBLIC_SITE_URL=https://power-now.vercel.app

# GitHub-backed public merchandising configuration.
CONFIG_READ_MODE=github
CONFIG_WRITE_MODE=github
GITHUB_REPO=AccelAnalysis/PowerNow
GITHUB_BRANCH=main
SETTINGS_FILE_PATH=data/site-settings.json
BOOKS_FILE_PATH=data/books.json

# Optional convenience token for server-side GitHub writes.
# A fine-grained token should be restricted to this repository and Contents: Read and write.
# The admin screen also supports entering this token only for the current browser session.
GITHUB_TOKEN=

# Optional separate admin passphrase. When configured, write and order endpoints require it.
ADMIN_TOKEN=

# Dynamic Stripe Checkout, order center, fulfillment, and webhooks.
# Each available book can have its own Payment Link fallback in data/books.json.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=true

# Paid-order ledger destination (for example, the supplied Google Apps Script web app).
ORDER_LEDGER_WEBHOOK_URL=
ORDER_LEDGER_SIGNING_SECRET=

# Optional print-on-demand, 3PL, shipping, or workflow-provider webhook.
FULFILLMENT_WEBHOOK_URL=
FULFILLMENT_WEBHOOK_SIGNING_SECRET=

# Optional operational notification destination supported by your downstream workflow.
FULFILLMENT_NOTIFICATION_EMAIL=orders@accelanalysis.com
