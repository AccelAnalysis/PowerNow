# Public URL of the deployed storefront.
NEXT_PUBLIC_SITE_URL=https://powernow.example.com

# Stripe Checkout. Use test keys until ready for production.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_AUTOMATIC_TAX=false

# Admin editor protection. Set a long random value before deploying.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Where admin saves storefront settings.
# local = writes data/site-settings.json on the Node server filesystem.
# github = writes data/site-settings.json back to this repository through GitHub Contents API.
CONFIG_WRITE_MODE=local
CONFIG_READ_MODE=local
GITHUB_TOKEN=github_pat_replace_me
GITHUB_REPO=AccelAnalysis/PowerNow
GITHUB_BRANCH=main
SETTINGS_FILE_PATH=data/site-settings.json
